{
  "name": "codex-paired-superpowers",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "check:vendored": "node scripts/check-vendored-deps.mjs",
    "check:bash32": "node scripts/check-bash32.mjs",
    "pretest": "node scripts/typecheck.mjs && node scripts/check-vendored-deps.mjs && node scripts/check-bash32.mjs",
    "test": "node --test $(node scripts/collect-test-files.mjs)",
    "test:shell": "bash scripts/run-shell-tests.sh",
    "test:fresh-clone": "node scripts/fresh-clone-smoke.mjs",
    "test:affected": "node scripts/tia.mjs run",
    "test:affected:main": "node scripts/tia.mjs run --base main",
    "test:tia-build": "node scripts/tia.mjs build",
    "test:tia-refresh": "node scripts/tia.mjs refresh",
    "test:installed-smoke": "CPS_INSTALLED_SMOKE=1 node --test tests/installed-smoke/codex-real.test.js tests/installed-smoke/codex-mcp-reliability.test.js tests/installed-smoke/ollama-real.test.js tests/installed-smoke/agy-real.test.js",
    "test:replay": "node --test tests/replay/replay-from-sidecar.test.js",
    "test:all": "node --test $(node scripts/collect-test-files.mjs --all)",
    "release-gate": "./scripts/v0.9.0-release-gate.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ajv": "^8.20.0",
    "typescript": "~5.9.3"
  }
}
