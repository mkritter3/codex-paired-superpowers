#!/usr/bin/env bash
# codex-paired-superpowers doctor — preflight checks.
#
# Run this when you first install the plugin, when a skill fails with what
# looks like a setup error, or anytime you want to verify the install is
# healthy. The script makes no changes to your system; it only reports what
# is and isn't configured.
#
# Output: human-readable summary on stdout. Pass --json to get a machine-
# parseable report instead (one object per check + a summary).
#
# Exit code: 0 if all checks pass or only warn, 1 if any FAIL.
set -uo pipefail

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
WANT_JSON=0
FORCE_AVAILABILITY=0
for arg in "$@"; do
  case "$arg" in
    --json)  WANT_JSON=1 ;;
    --force) FORCE_AVAILABILITY=1 ;;
  esac
done

# ── Result accumulator ────────────────────────────────────────────────────
declare -a RESULTS=()
declare -i FAIL_COUNT=0
declare -i WARN_COUNT=0
declare -i PASS_COUNT=0

record() {
  # record <status> <check-name> <detail> [fix-command]
  local status="$1" name="$2" detail="$3" fix="${4-}"
  case "$status" in
    pass) PASS_COUNT=$((PASS_COUNT + 1)) ;;
    warn) WARN_COUNT=$((WARN_COUNT + 1)) ;;
    fail) FAIL_COUNT=$((FAIL_COUNT + 1)) ;;
  esac
  RESULTS+=("$status|$name|$detail|$fix")
}

# ── Check 1: node v20+ ────────────────────────────────────────────────────
if ! command -v node >/dev/null 2>&1; then
  record fail "node" "node not on PATH" \
    "Install Node 20+ from https://nodejs.org or via: brew install node@20"
else
  NODE_V=$(node --version 2>/dev/null | sed 's/^v//')
  NODE_MAJOR="${NODE_V%%.*}"
  if [ -z "$NODE_MAJOR" ] || ! [ "$NODE_MAJOR" -ge 20 ] 2>/dev/null; then
    record fail "node" "node $NODE_V found; v20+ required" \
      "brew upgrade node OR install v20+ from https://nodejs.org"
  else
    record pass "node" "v$NODE_V (>=v20 OK)" ""
  fi
fi

# ── Check 2: codex CLI ────────────────────────────────────────────────────
if ! command -v codex >/dev/null 2>&1; then
  record fail "codex-cli" "codex not on PATH — required for the bundled MCP server and the 7-round Claude<->Codex loop" \
    "brew install openai/codex/codex   # or: npm install -g @openai/codex"
else
  CODEX_V=$(codex --version 2>/dev/null | head -1 | sed 's/codex //' || echo "unknown")
  record pass "codex-cli" "$CODEX_V" ""
fi

# ── Check 3: codex authentication ─────────────────────────────────────────
# Heuristic: codex stores auth state at ~/.codex/config.toml or similar.
# A fast non-destructive probe: codex login --help should succeed; an
# unauthenticated codex throws on mcp-server start. We try the cheaper check.
if command -v codex >/dev/null 2>&1; then
  if codex login --help >/dev/null 2>&1; then
    # CLI is responsive; check for credential file.
    if [ -f "$HOME/.codex/config.toml" ] || [ -f "$HOME/.codex/auth.json" ] || [ -f "$HOME/.config/codex/auth.json" ]; then
      record pass "codex-auth" "credentials present" ""
    else
      record warn "codex-auth" "no codex auth file detected; first invocation may prompt for login" \
        "Run: codex login"
    fi
  else
    record warn "codex-auth" "could not probe codex auth state (codex CLI present but unresponsive)" \
      "Run: codex login"
  fi
fi

# ── Check 4: git v2.5+ (for worktrees) ────────────────────────────────────
if ! command -v git >/dev/null 2>&1; then
  record fail "git" "git not on PATH — required for autopilot's worktree-based parallel slice dispatch" \
    "Install git: brew install git (macOS) or your OS package manager"
else
  GIT_V=$(git --version 2>/dev/null | sed 's/git version //')
  GIT_MAJOR="${GIT_V%%.*}"
  GIT_REST="${GIT_V#*.}"
  GIT_MINOR="${GIT_REST%%.*}"
  # Require >= 2.5 (git worktree was introduced in 2.5).
  if [ "$GIT_MAJOR" -lt 2 ] 2>/dev/null || { [ "$GIT_MAJOR" = "2" ] && [ "$GIT_MINOR" -lt 5 ] 2>/dev/null; }; then
    record warn "git" "git $GIT_V found; >=2.5 recommended for worktree support" \
      "Update git via your OS package manager"
  else
    record pass "git" "$GIT_V" ""
  fi
fi

# ── Check 5: vendored node_modules (proper-lockfile must be importable) ───
if [ -f "$PLUGIN_ROOT/node_modules/proper-lockfile/package.json" ]; then
  record pass "vendored-deps" "proper-lockfile + transitive deps present at $PLUGIN_ROOT/node_modules" ""
else
  record fail "vendored-deps" "vendored node_modules missing or incomplete at $PLUGIN_ROOT/node_modules — mailbox + autopilot will fail at runtime" \
    "Reinstall the plugin: /plugin uninstall codex-paired-superpowers@codex-paired-superpowers && /plugin install codex-paired-superpowers@codex-paired-superpowers"
fi

# ── Check 6: bridge CLI is loadable ───────────────────────────────────────
if command -v node >/dev/null 2>&1 && [ -f "$PLUGIN_ROOT/lib/codex-bridge/cli.js" ]; then
  # Try a non-destructive invocation. Any subcommand-not-found prints the
  # available list to stderr — that's a successful module load.
  CLI_PROBE=$(node "$PLUGIN_ROOT/lib/codex-bridge/cli.js" __doctor_probe__ 2>&1 || true)
  if echo "$CLI_PROBE" | grep -q "unknown subcommand"; then
    record pass "bridge-cli" "lib/codex-bridge/cli.js loads cleanly" ""
  else
    # Extract the most informative single line from node's traceback.
    PROBE_SUMMARY=$(echo "$CLI_PROBE" | grep -E "Error|Cannot find|SyntaxError" | head -1)
    [ -z "$PROBE_SUMMARY" ] && PROBE_SUMMARY=$(echo "$CLI_PROBE" | head -1)
    record fail "bridge-cli" "lib/codex-bridge/cli.js failed to load: $PROBE_SUMMARY" \
      "Most likely vendored-deps is also failing (above). Reinstall the plugin."
  fi
fi

# ── Check 7: hook files present + executable ──────────────────────────────
if [ -x "$PLUGIN_ROOT/hooks/mailbox-inject.sh" ] && [ -x "$PLUGIN_ROOT/hooks/check-commit-provenance.sh" ]; then
  record pass "hooks" "PostToolUse hooks present and executable" ""
elif [ -f "$PLUGIN_ROOT/hooks/mailbox-inject.sh" ]; then
  record warn "hooks" "hook files present but not executable" \
    "chmod +x $PLUGIN_ROOT/hooks/*.sh"
else
  record fail "hooks" "hook files missing at $PLUGIN_ROOT/hooks/" \
    "Reinstall the plugin"
fi

# ── Check 8: current working directory has writable .codex-paired/ ────────
# This isn't always required (only inside an active autopilot project) but
# is useful diagnostic when something IS expected and isn't working.
if [ -d ".codex-paired" ]; then
  if [ -w ".codex-paired" ]; then
    record pass "project-state-dir" ".codex-paired/ in current directory is writable" ""
  else
    record fail "project-state-dir" ".codex-paired/ in current directory is NOT writable" \
      "Check filesystem permissions: ls -la .codex-paired/"
  fi
else
  # Not having .codex-paired/ is fine — most repos won't have it until
  # autopilot first runs there. Report as informational only.
  record pass "project-state-dir" "no .codex-paired/ in cwd (informational; created lazily by autopilot)" ""
fi

# ── Check 9: configured model roles against the local Codex catalog ────────
# Spec §8: configuration errors are fatal because every role-aware skill would stop.
# Catalog problems are warnings only: a cache is advisory and never proves account access.
MODELS_JSON=""
if command -v node >/dev/null 2>&1 && [ -f "$PLUGIN_ROOT/lib/codex-bridge/cli.js" ]; then
  if MODELS_JSON=$(node "$PLUGIN_ROOT/lib/codex-bridge/cli.js" model-roles 2>&1); then
    CODEX_MODELS_HOME="${CODEX_HOME:-$HOME/.codex}"
    MODELS_CATALOG="$CODEX_MODELS_HOME/models_cache.json"
    AGY_INSTALLED=0
    if command -v agy >/dev/null 2>&1; then
      AGY_INSTALLED=1
    fi
    MODELS_CHECK=$(node -e '
      const fs = require("node:fs");
      const { execFileSync } = require("node:child_process");

      const catalogPath = process.argv[1];
      const resolved = JSON.parse(process.argv[2]);
      const agyInstalled = process.argv[3] === "1";

      const roleEntries = Object.entries(resolved.roles);
      const roleDetails = roleEntries.map(([role, config]) => {
        const source = resolved.sources[role];
        const sourceLabel = source.model === source.effort
          ? source.model
          : `${source.model}/${source.effort}`;
        const cliPrefix = config.cli === "agy" ? "agy " : "";
        return `${role}: ${cliPrefix}${config.model} ${config.effort} (${sourceLabel})`;
      });

      const codexRoles = roleEntries.filter(([, config]) => (config.cli || "codex") === "codex");
      const agyRoles = roleEntries.filter(([, config]) => config.cli === "agy");

      const warnings = [];
      const notes = [];

      // ── Codex catalog checks (apply only to codex roles) ──
      if (codexRoles.length > 0) {
        if (!fs.existsSync(catalogPath)) {
          notes.push("catalog not cached; model checks skipped");
        } else {
          let catalog = null;
          try {
            catalog = JSON.parse(fs.readFileSync(catalogPath, "utf8"));
            if (!Array.isArray(catalog.models)) throw new Error("models[] is missing");
          } catch (error) {
            warnings.push(`catalog unreadable: ${error.message}`);
          }

          if (catalog) {
            try {
              const fetchedAt = Date.parse(catalog.fetched_at);
              if (Number.isFinite(fetchedAt)) {
                const ageMs = Date.now() - fetchedAt;
                if (ageMs > 7 * 86400000) warnings.push(`catalog is ${Math.floor(ageMs / 86400000)} days old`);
              }

              const catalogBySlug = new Map();
              for (const model of catalog.models) {
                if (!model || typeof model !== "object" || typeof model.slug !== "string") {
                  throw new Error("models[] contains an entry without a string slug");
                }
                catalogBySlug.set(model.slug, model);
              }
              const configuredModels = new Set(codexRoles.map(([, config]) => config.model));
              for (const modelName of configuredModels) {
                const model = catalogBySlug.get(modelName);
                if (!model) {
                  warnings.push(`${modelName} is missing from the catalog`);
                  continue;
                }
                if (model.upgrade && typeof model.upgrade === "object" && model.upgrade.retirement_at) {
                  warnings.push(`${modelName} retires on ${model.upgrade.retirement_at}`);
                }
              }

              for (const [role, config] of codexRoles) {
                const model = catalogBySlug.get(config.model);
                if (!model) continue;
                const supported = Array.isArray(model.supported_reasoning_levels)
                  ? model.supported_reasoning_levels.map((level) => level?.effort)
                  : [];
                if (!supported.includes(config.effort)) {
                  warnings.push(`${role}: ${config.model} does not support effort ${config.effort}`);
                }
              }
            } catch (error) {
              warnings.push(`catalog unreadable: ${error.message}`);
            }
          }

          notes.push("catalog presence does not prove account access");
        }
      }

      // ── Antigravity (agy) checks ──
      if (agyRoles.length > 0) {
        if (!agyInstalled) {
          for (const [role] of agyRoles) {
            warnings.push(`role ${role} uses agy but agy is not installed`);
          }
        } else {
          let agyModelsList = null;
          const agyCachePath = ".codex-paired/agy-models-cache.json";
          if (fs.existsSync(agyCachePath)) {
            try {
              const cached = JSON.parse(fs.readFileSync(agyCachePath, "utf8"));
              const fetchedAt = Date.parse(cached.cached_at);
              if (Number.isFinite(fetchedAt) && Date.now() - fetchedAt < 3600000 && Array.isArray(cached.models)) {
                agyModelsList = cached.models;
              }
            } catch {
              // Ignore cache parse error
            }
          }
          if (!agyModelsList) {
            try {
              const stdout = execFileSync("agy", ["models"], {
                stdio: ["ignore", "pipe", "pipe"],
                encoding: "utf8",
                timeout: 15000,
              });
              const models = stdout
                .split(/\r?\n/)
                .map((l) => l.trim())
                .filter(Boolean)
                .map((l) => l.split(/\s+/)[0])
                .filter(Boolean);
              agyModelsList = models;
              try {
                if (!fs.existsSync(".codex-paired")) fs.mkdirSync(".codex-paired", { recursive: true });
                fs.writeFileSync(agyCachePath, JSON.stringify({ cached_at: new Date().toISOString(), models }), "utf8");
              } catch {
                // Ignore cache write error
              }
            } catch (err) {
              warnings.push(`could not query agy models: ${err.message}`);
            }
          }

          if (agyModelsList) {
            const agyConfiguredModels = new Set(agyRoles.map(([, config]) => config.model));
            for (const modelId of agyConfiguredModels) {
              if (!agyModelsList.includes(modelId)) {
                warnings.push(`${modelId} is missing from agy models`);
              }
            }
          }
        }
      } else if (!agyInstalled) {
        notes.push("agy not installed; Gemini roles unverified");
      }

      const detail = [...roleDetails, ...warnings, ...notes].filter(Boolean).join("; ");
      process.stdout.write(`${warnings.length ? "warn" : "pass"}|${detail}`);
    ' "$MODELS_CATALOG" "$MODELS_JSON" "$AGY_INSTALLED" 2>&1)
    IFS='|' read -r MODELS_STATUS MODELS_DETAIL <<< "$MODELS_CHECK"
    case "$MODELS_STATUS" in
      pass|warn|fail) ;;
      *) MODELS_DETAIL="catalog check did not produce a status: $(printf '%s' "$MODELS_CHECK" | tr '\n' ' ' | cut -c1-300)"; MODELS_STATUS=warn ;;
    esac
    record "$MODELS_STATUS" "models" "$MODELS_DETAIL" ""
  else
    MODELS_ERROR=$(printf '%s' "$MODELS_JSON" | tr '\n' ' ')
    record fail "models" "model role resolution failed: $MODELS_ERROR" \
      "Fix .codex-paired/project.json models or CODEX_PAIRED_MODEL*/CODEX_PAIRED_REASONING* overrides"
    MODELS_JSON=""
  fi
else
  record fail "models" "model role resolution unavailable because node or the bridge CLI is missing" \
    "Resolve the node or bridge-cli FAIL above"
fi

# ── Check 10: Codex CLI version and MCP server transport ───────────────
# Spec §8: these compatibility probes are warn-only.
if command -v codex >/dev/null 2>&1; then
  CODEX_VERSION_OUTPUT=$(codex --version 2>&1 | head -1)
  if codex mcp-server --help >/dev/null 2>&1; then
    MCP_SERVER_AVAILABLE=1
  else
    MCP_SERVER_AVAILABLE=0
  fi

  if [ -n "$MODELS_JSON" ]; then
    TRANSPORT_CHECK=$(node --input-type=module -e '
      import { pathToFileURL } from "node:url";
      const { compareVersions } = await import(pathToFileURL(process.argv[1]).href);
      const installedOutput = process.argv[2];
      const validated = JSON.parse(process.argv[3]).validated_cli_version;
      const mcpAvailable = process.argv[4] === "1";
      const installed = installedOutput.match(/\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.-]+)?/)?.[0];
      const warnings = [];
      if (!installed) {
        warnings.push(`could not parse Codex version from ${JSON.stringify(installedOutput)}`);
      } else if (compareVersions(installed, validated) < 0) {
        warnings.push(`Codex ${installed} is older than the version v0.16.0 was validated against (${validated})`);
      }
      if (!mcpAvailable) {
        warnings.push("this Codex build does not offer the MCP server transport the plugin uses; pin an older Codex or wait for a plugin release that moves transports");
      }
      const confirmations = [];
      if (installed && compareVersions(installed, validated) >= 0) {
        confirmations.push(`Codex ${installed} is at or above validated ${validated}`);
      }
      if (mcpAvailable) confirmations.push("MCP server transport available");
      process.stdout.write(`${warnings.length ? "warn" : "pass"}|${[...warnings, ...confirmations].join("; ")}`);
    ' "$PLUGIN_ROOT/lib/codex-bridge/models.js" "$CODEX_VERSION_OUTPUT" "$MODELS_JSON" "$MCP_SERVER_AVAILABLE" 2>&1)
    IFS='|' read -r TRANSPORT_STATUS TRANSPORT_DETAIL <<< "$TRANSPORT_CHECK"
    record "$TRANSPORT_STATUS" "codex-transport" "$TRANSPORT_DETAIL" ""
  else
    TRANSPORT_DETAIL="validated CLI version unavailable because model-role resolution failed"
    if [ "$MCP_SERVER_AVAILABLE" -eq 0 ]; then
      TRANSPORT_DETAIL="$TRANSPORT_DETAIL; this Codex build does not offer the MCP server transport the plugin uses"
    fi
    record warn "codex-transport" "$TRANSPORT_DETAIL" ""
  fi
else
  record warn "codex-transport" "codex not on PATH; transport compatibility checks skipped" ""
fi

# ── Output ───────────────────────────────────────────────────────────────
if [ "$WANT_JSON" -eq 1 ]; then
  # Run availability report in JSON mode and embed the result. Round-1
  # fix: previously --json --force ran the standard checks but dropped
  # the availability section entirely, leaving programmatic consumers
  # blind to which CLIs are installed and routable.
  AVAIL_JSON=""
  if [ -f "$PLUGIN_ROOT/lib/codex-bridge/availability/doctor-report.js" ] && command -v node >/dev/null 2>&1; then
    if [ "$FORCE_AVAILABILITY" -eq 1 ]; then
      AVAIL_JSON=$(node "$PLUGIN_ROOT/lib/codex-bridge/availability/doctor-report.js" --json --force 2>/dev/null || true)
    else
      AVAIL_JSON=$(node "$PLUGIN_ROOT/lib/codex-bridge/availability/doctor-report.js" --json 2>/dev/null || true)
    fi
  fi
  # Emit machine-readable JSON (one summary + array of checks + availability)
  printf '{\n'
  printf '  "summary": {"pass": %d, "warn": %d, "fail": %d},\n' "$PASS_COUNT" "$WARN_COUNT" "$FAIL_COUNT"
  printf '  "checks": [\n'
  first=1
  for entry in "${RESULTS[@]}"; do
    IFS='|' read -r status name detail fix <<< "$entry"
    [ "$first" -eq 1 ] || printf ',\n'
    first=0
    # JSON-escape via node since detail/fix may contain quotes
    node -e "process.stdout.write(JSON.stringify({status: process.argv[1], name: process.argv[2], detail: process.argv[3], fix: process.argv[4] || null}))" "$status" "$name" "$detail" "$fix" | sed 's/^/    /'
  done
  printf '\n  ]'
  if [ -n "$AVAIL_JSON" ]; then
    printf ',\n  "availability": %s' "$AVAIL_JSON"
  else
    printf ',\n  "availability": null'
  fi
  printf '\n}\n'
else
  echo "codex-paired-superpowers doctor — checks against PLUGIN_ROOT=$PLUGIN_ROOT"
  echo ""
  for entry in "${RESULTS[@]}"; do
    IFS='|' read -r status name detail fix <<< "$entry"
    case "$status" in
      pass) printf "  PASS  %-20s  %s\n" "$name" "$detail" ;;
      warn) printf "  WARN  %-20s  %s\n" "$name" "$detail"
            [ -n "$fix" ] && printf "        fix:  %s\n" "$fix" ;;
      fail) printf "  FAIL  %-20s  %s\n" "$name" "$detail"
            [ -n "$fix" ] && printf "        fix:  %s\n" "$fix" ;;
    esac
  done
  echo ""
  echo "Summary: $PASS_COUNT pass, $WARN_COUNT warn, $FAIL_COUNT fail."
  if [ "$FAIL_COUNT" -gt 0 ]; then
    echo "Action required: address FAIL items above before using the plugin."
  elif [ "$WARN_COUNT" -gt 0 ]; then
    echo "Plugin should work; review WARN items if you hit issues."
  else
    echo "All checks green. Plugin is ready to use."
  fi

  # ── CLI availability + per-role fallback hints (v0.9.0 slice 4) ─────────
  # The availability section is informational. It uses doctor's 1h-TTL
  # cache at .codex-paired/cli-availability.json. --force re-probes and
  # rewrites the cache. Failures here do NOT change the overall doctor
  # exit code — vendored-deps / hook checks above remain authoritative.
  if [ -f "$PLUGIN_ROOT/lib/codex-bridge/availability/doctor-report.js" ] && command -v node >/dev/null 2>&1; then
    echo ""
    if [ "$FORCE_AVAILABILITY" -eq 1 ]; then
      AVAIL_ARGS="--force"
    else
      AVAIL_ARGS=""
    fi
    node "$PLUGIN_ROOT/lib/codex-bridge/availability/doctor-report.js" $AVAIL_ARGS || true
  fi
fi

# Exit non-zero only on FAIL.
[ "$FAIL_COUNT" -eq 0 ]
